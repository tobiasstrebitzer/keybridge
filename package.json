{
  "name": "keybridge",
  "version": "0.4.1",
  "description": "Safe WebAuthn bridge for npm publishing from agents: the agent initiates, the human approves via Touch ID - the ceremony runs in an invisible windowless WKWebView.",
  "license": "MIT",
  "type": "module",
  "author": "Tobias Strebitzer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobiasstrebitzer/keybridge.git"
  },
  "homepage": "https://github.com/tobiasstrebitzer/keybridge#readme",
  "bugs": "https://github.com/tobiasstrebitzer/keybridge/issues",
  "keywords": [
    "npm-publish",
    "webauthn",
    "touch-id",
    "secure-enclave",
    "2fa",
    "mcp",
    "claude-code",
    "agent",
    "passkey"
  ],
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "keybridge": "dist/cli.mjs",
    "keybridge-mcp": "dist/server.mjs"
  },
  "files": [
    "dist",
    "native"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc --noEmit",
    "keybridge": "node src/cli.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@silkweave/core": "^4.0.0",
    "@silkweave/mcp": "^4.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "oxlint": "^1.73.0",
    "tsdown": "^0.22.6",
    "typescript": "^7.0.2"
  }
}
