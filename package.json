{
  "name": "keybridge",
  "version": "0.2.0",
  "description": "Safe WebAuthn bridge for npm publishing from agents: the agent initiates, the human approves via Touch ID in an invisible off-screen Chrome.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "keybridge": "dist/cli.mjs",
    "keybridge-mcp": "dist/server.mjs"
  },
  "files": [
    "dist",
    "v2/extension",
    "v2/host",
    "v2/helper",
    "v2/install.mjs"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@silkweave/core": "^4.0.0",
    "@silkweave/mcp": "^4.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "oxlint": "^1.73.0",
    "tsdown": "^0.22.6",
    "typescript": "^7.0.2"
  }
}
